{
    "name": "beziworld/laravel-paypo",
    "description": "PayPo buy now, pay later gateway for Laravel: transactions, confirmation, refunds, cancellations and HMAC-signed notifications.",
    "keywords": ["laravel","paypo","bnpl","buy-now-pay-later","deferred-payments","payments","poland"],
    "homepage": "https://github.com/beziworld/laravel-paypo",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Kamil Ćwiertnia",
            "email": "biuro@beziworld.eu",
            "homepage": "https://beziworld.eu",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/beziworld/laravel-paypo/issues",
        "source": "https://github.com/beziworld/laravel-paypo"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beziworld\\PayPo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beziworld\\PayPo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beziworld\\PayPo\\PayPoServiceProvider"
            ],
            "aliases": {
                "PayPo": "Beziworld\\PayPo\\Facades\\PayPo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
